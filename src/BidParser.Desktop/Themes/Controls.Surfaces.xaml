<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cfg="clr-namespace:BidParser.Desktop.Configuration"
                    xmlns:mvvm="clr-namespace:BidParser.Desktop.Mvvm"
                    xmlns:vm="clr-namespace:BidParser.Desktop.ViewModels">

  <!-- Guidance blocks. The model is already validated; these templates only lay it out. -->
  <DataTemplate DataType="{x:Type cfg:GuidanceParagraph}">
    <TextBlock Margin="{StaticResource Space.Bottom4}"
               Style="{StaticResource Text.BodySecondary}"
               Foreground="{DynamicResource Brush.InfoText}"
               TextWrapping="Wrap"
               mvvm:GuidanceInlines.Runs="{Binding Runs}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type cfg:GuidanceListItem}">
    <Grid Margin="{StaticResource Space.Bottom2}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="{StaticResource Space.Right8}"
                 VerticalAlignment="Top"
                 Style="{StaticResource Text.BodySecondary}"
                 Foreground="{DynamicResource Brush.InfoText}"
                 Text="•" />
      <TextBlock Grid.Column="1"
                 Style="{StaticResource Text.BodySecondary}"
                 Foreground="{DynamicResource Brush.InfoText}"
                 TextWrapping="Wrap"
                 mvvm:GuidanceInlines.Runs="{Binding Runs}" />
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type cfg:GuidanceBulletList}">
    <ItemsControl Margin="{StaticResource Space.Bottom4}" ItemsSource="{Binding Items}" />
  </DataTemplate>
  <Style x:Key="Surface.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
  </Style>

  <Style x:Key="Surface.MessageBar" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Bar}" />
    <Setter Property="Padding" Value="{StaticResource Space.MessageBar}" />
  </Style>

  <Style x:Key="Bar.Info" TargetType="Border" BasedOn="{StaticResource Surface.MessageBar}">
    <Setter Property="Background" Value="{DynamicResource Brush.InfoWash}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InfoBorder}" />
  </Style>
  <Style x:Key="Bar.Success" TargetType="Border" BasedOn="{StaticResource Surface.MessageBar}">
    <Setter Property="Background" Value="{DynamicResource Brush.SuccessWash}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
  </Style>
  <Style x:Key="Bar.Warning" TargetType="Border" BasedOn="{StaticResource Surface.MessageBar}">
    <Setter Property="Background" Value="{DynamicResource Brush.WarningWash}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}" />
  </Style>

  <!-- The drop zone hosts its own state surfaces, so the button itself contributes only the
       focus ring and the hit area. -->
  <Style x:Key="Surface.DropZone" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Brush.Focus}"
                    BorderThickness="{StaticResource Border.Focus}"
                    CornerRadius="{StaticResource Radius.Panel}"
                    Visibility="Collapsed" />
            <ContentPresenter Margin="{StaticResource Space.2}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Progress.Thin" TargetType="ProgressBar">
    <Setter Property="Height" Value="{StaticResource Size.Progress}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid ClipToBounds="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Bar}" />
            <Border x:Name="PART_Indicator"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{StaticResource Radius.Bar}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tooltips follow the theme like native Windows 11 tooltips: a surface-coloured card with a
       border. The template scopes Text.ControlForeground and wrapping over string content, which
       the application-level TextBlock style would otherwise recolour and leave on one line. -->
  <Style TargetType="ToolTip">
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Control}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.ControlForeground}">
                  <Setter Property="FontSize" Value="12" />
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Data grid column header: themed, centred and padded. The resize grippers keep the
       PART_ names DataGrid looks for, so columns stay user-resizable. -->
  <Style x:Key="Grid.ColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Data grid body text. One explicit size and family for every cell, vertically centred:
       DataGridTextColumn otherwise uses its own top-aligned element style at the system font,
       while template columns pick up the application's larger implicit TextBlock style. -->
  <Style x:Key="Grid.CellText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.Regular}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="{StaticResource Space.Horizontal8}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Editable grid cell (IM%, Uplift). The border reports the field's state: red while the value
       is missing or invalid, green once it is valid, neutral when an optional field is blank. The
       template keeps that colour while focused (focus thickens the border instead of recolouring
       it), so the state is visible while the user types. Derived styles supply the state triggers. -->
  <Style x:Key="Grid.CellInput" TargetType="TextBox">
    <Setter Property="Width" Value="82" />
    <Setter Property="Height" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Bar}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderThickness" Value="{StaticResource Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Grid.CellInput.ImPercent" TargetType="TextBox" BasedOn="{StaticResource Grid.CellInput}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsImValueValid}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasImError}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Grid.CellInput.Uplift" TargetType="TextBox" BasedOn="{StaticResource Grid.CellInput}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsUpliftValueValid}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasUpliftError}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Grid.ColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0,0,1,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.ControlForeground}">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <Thumb x:Name="PART_LeftHeaderGripper"
                   HorizontalAlignment="Left"
                   Style="{StaticResource Grid.ColumnHeaderGripper}" />
            <Thumb x:Name="PART_RightHeaderGripper"
                   HorizontalAlignment="Right"
                   Style="{StaticResource Grid.ColumnHeaderGripper}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Surface.Dialog" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
    <Setter Property="Width" Value="{StaticResource Size.DialogWidth}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}" />
    <Setter Property="Padding" Value="{StaticResource Space.20}" />
  </Style>

  <!-- The single dialog host: scrim plus a centred dialog, drawn over the whole window rather
       than in a second Window, so Esc handling and focus stay in one place. -->
  <Style x:Key="Overlay.DialogHost" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource Brush.Scrim}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Host for a dialog that fills the window (less a margin) by default and can be resized with
       its grip; the dialog's own Width/Height, once dragged, centre it within this area. -->
  <Style x:Key="Overlay.ResizableDialogHost" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource Brush.Scrim}">
            <ContentPresenter Margin="{StaticResource Space.24}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Drop zone states ============================ -->

  <DataTemplate DataType="{x:Type vm:EmptyDropZoneViewModel}">
    <Grid>
      <Rectangle RadiusX="{StaticResource Radius.PanelValue}"
                 RadiusY="{StaticResource Radius.PanelValue}"
                 Fill="{DynamicResource Brush.SurfaceEmpty}"
                 Stroke="{DynamicResource Brush.BorderStrong}"
                 StrokeThickness="{StaticResource Size.BorderThickness}"
                 StrokeDashArray="4 2" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center"
                   FontWeight="{StaticResource Weight.SemiBold}"
                   Text="Drop quote file here" />
        <TextBlock Margin="{StaticResource Space.Top4}"
                   HorizontalAlignment="Center"
                   Style="{StaticResource Text.Caption}"
                   Text="{Binding AcceptedCaption}" />
        <TextBlock Margin="{StaticResource Space.Top8}"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Brush.Accent}"
                   FontWeight="{StaticResource Weight.SemiBold}"
                   FontSize="13"
                   Text="Browse…" />
        <TextBlock Margin="{StaticResource Space.Top4}"
                   HorizontalAlignment="Center"
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Text="One file at a time · Ctrl+O opens the file picker" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DragOverDropZoneViewModel}">
    <Grid>
      <Rectangle RadiusX="{StaticResource Radius.PanelValue}"
                 RadiusY="{StaticResource Radius.PanelValue}"
                 Fill="{DynamicResource Brush.InfoWash}"
                 Stroke="{DynamicResource Brush.Accent}"
                 StrokeThickness="{StaticResource Size.FocusThickness}"
                 StrokeDashArray="4 2" />
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.AccentHover}"
                 FontWeight="{StaticResource Weight.SemiBold}"
                 Text="Release to load" />
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:InvalidDropZoneViewModel}">
    <Border Background="{DynamicResource Brush.ErrorWash}"
            BorderBrush="{DynamicResource Brush.Error}"
            BorderThickness="{StaticResource Border.All}"
            CornerRadius="{StaticResource Radius.Panel}"
            Padding="{StaticResource Space.16}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="{StaticResource Size.MessageGlyph}"
                Height="{StaticResource Size.MessageGlyph}"
                Margin="{StaticResource Space.Right12}"
                VerticalAlignment="Top"
                Background="{DynamicResource Brush.Error}"
                CornerRadius="{StaticResource Radius.Control}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Surface}"
                     FontSize="11"
                     FontWeight="{StaticResource Weight.Bold}"
                     Text="!" />
        </Border>
        <StackPanel>
          <TextBlock FontWeight="{StaticResource Weight.SemiBold}"
                     Foreground="{DynamicResource Brush.ErrorText}"
                     TextWrapping="Wrap"
                     Text="{Binding Headline}" />
          <TextBlock Margin="{StaticResource Space.Top4}"
                     Style="{StaticResource Text.BodySecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding Detail}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FileDropZoneViewModel}">
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="{StaticResource Border.All}"
            CornerRadius="{StaticResource Radius.Panel}"
            Padding="{StaticResource Space.Horizontal12}">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="{StaticResource Size.FileBadgeWidth}"
                Height="{StaticResource Size.FileBadgeHeight}"
                Margin="{StaticResource Space.Right12}"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="{StaticResource Border.All}"
                CornerRadius="{StaticResource Radius.Bar}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="{StaticResource Space.Bottom4}"
                     Foreground="{DynamicResource Brush.Error}"
                     FontSize="9"
                     FontWeight="{StaticResource Weight.Bold}"
                     Text="{Binding File.Badge}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontWeight="{StaticResource Weight.SemiBold}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding File.DisplayName}"
                     ToolTip="{Binding File.DisplayName}" />
          <TextBlock Margin="{StaticResource Space.Top2}"
                     Style="{StaticResource Text.Caption}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding File.Metadata}" />
          <TextBlock x:Name="Status"
                     Margin="{StaticResource Space.Top4}"
                     Style="{StaticResource Text.Caption}"
                     Foreground="{DynamicResource Brush.TextMuted}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Status}" />
        </StackPanel>

        <Button Grid.Column="2"
                Margin="{StaticResource Space.Right8}"
                Style="{StaticResource Button.Compact}"
                Content="Replace"
                Visibility="{Binding CanReplace, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Replace quote file" />
        <Button Grid.Column="3"
                Style="{StaticResource Button.Subtle}"
                Content="✕"
                Visibility="{Binding CanReplace, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Clear quote file" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:FileStatusSeverity.Working}">
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:FileStatusSeverity.Done}">
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Success}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ============================ Result region ============================ -->

  <DataTemplate DataType="{x:Type vm:NoResultViewModel}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="{StaticResource Size.Control}"
              Height="{StaticResource Size.Control}"
              HorizontalAlignment="Center"
              Background="{DynamicResource Brush.SurfaceInset}"
              BorderBrush="{DynamicResource Brush.BorderStrong}"
              BorderThickness="{StaticResource Border.All}"
              CornerRadius="{StaticResource Radius.Control}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Text="↔" />
      </Border>
      <TextBlock Margin="{StaticResource Space.Top12}"
                 HorizontalAlignment="Center"
                 FontWeight="{StaticResource Weight.SemiBold}"
                 Text="No quote parsed yet" />
      <TextBlock Margin="{StaticResource Space.Top4}"
                 HorizontalAlignment="Center"
                 Style="{StaticResource Text.Caption}"
                 Text="Warnings, totals and the saved workbook path appear here." />
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Result.Parsed">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBand"
              Background="{DynamicResource Brush.SuccessWash}"
              BorderBrush="{DynamicResource Brush.SuccessBorder}"
              BorderThickness="{StaticResource Border.Bottom}"
              CornerRadius="{StaticResource Radius.PanelTop}"
              Padding="{StaticResource Space.MessageBar}">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="HeaderGlyphChrome"
                  Width="{StaticResource Size.StatusGlyph}"
                  Height="{StaticResource Size.StatusGlyph}"
                  Margin="{StaticResource Space.Right8}"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Brush.Success}"
                  CornerRadius="{StaticResource Radius.Control}">
            <TextBlock x:Name="HeaderGlyph"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Surface}"
                       FontSize="11"
                       FontWeight="{StaticResource Weight.Bold}"
                       Text="✓" />
          </Border>
          <TextBlock x:Name="HeaderText"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="{StaticResource Weight.SemiBold}"
                     Foreground="{DynamicResource Brush.SuccessText}"
                     TextWrapping="Wrap"
                     Text="{Binding Headline}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Space.16}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.BodySecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding Detail}" />

          <ItemsControl Margin="{StaticResource Space.Top12}"
                        ItemsSource="{Binding Facts}"
                        Visibility="{Binding Facts, Converter={StaticResource EmptyToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="{StaticResource Space.Bottom12}">
                  <TextBlock Style="{StaticResource Text.SectionHeading}" Text="{Binding Label}" />
                  <TextBlock Margin="{StaticResource Space.Top2}"
                             FontWeight="{StaticResource Weight.SemiBold}"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Value}"
                             ToolTip="{Binding Value}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Notes}"
                        Visibility="{Binding Notes, Converter={StaticResource EmptyToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Bar.Warning}" Margin="{StaticResource Space.Bottom8}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="{StaticResource Space.Right8}"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource Brush.Warning}"
                               FontWeight="{StaticResource Weight.Bold}"
                               Text="⚠" />
                    <TextBlock Style="{StaticResource Text.BodySecondary}"
                               Foreground="{DynamicResource Brush.WarningText}"
                               TextWrapping="Wrap"
                               Text="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Bar.Info}"
                  Margin="{StaticResource Space.Bottom8}"
                  Visibility="{Binding Guidance, Converter={StaticResource EmptyToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Border Width="{StaticResource Size.MessageGlyph}"
                      Height="{StaticResource Size.MessageGlyph}"
                      Margin="{StaticResource Space.Right8}"
                      VerticalAlignment="Top"
                      Background="{DynamicResource Brush.Accent}"
                      CornerRadius="{StaticResource Radius.Control}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Surface}"
                           FontSize="11"
                           FontWeight="{StaticResource Weight.Bold}"
                           Text="i" />
              </Border>
              <ItemsControl ItemsSource="{Binding Guidance.Blocks}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Bar.Success}"
                  Visibility="{Binding SavedMessage, Converter={StaticResource EmptyToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         Style="{StaticResource Text.BodySecondary}"
                         Foreground="{DynamicResource Brush.SuccessText}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding SavedMessage}"
                         ToolTip="{Binding SavedPath}" />
              <Button Grid.Column="1"
                      Margin="{StaticResource Space.Horizontal8}"
                      Style="{StaticResource Button.Compact}"
                      Content="Open folder"
                      Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      AutomationProperties.Name="Open the folder containing the saved workbook" />
            </Grid>
          </Border>

          <StackPanel Margin="{StaticResource Space.Top12}" Orientation="Horizontal">
            <Button Margin="{StaticResource Space.Right8}"
                    Style="{StaticResource Button.Compact}"
                    Content="Edit pricing"
                    Visibility="{Binding CanEditPricing, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding DataContext.EditPricingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Edit per-line pricing" />
            <Button Style="{StaticResource Button.Compact}"
                    Content="Parse another file"
                    Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Parse another file" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:ResultSeverity.Warning}">
        <Setter TargetName="HeaderBand" Property="Background" Value="{DynamicResource Brush.WarningWash}" />
        <Setter TargetName="HeaderBand" Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}" />
        <Setter TargetName="HeaderGlyphChrome" Property="Background" Value="{DynamicResource Brush.Warning}" />
        <Setter TargetName="HeaderGlyph" Property="Text" Value="!" />
        <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource Brush.WarningText}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SuccessResultViewModel}">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Result.Parsed}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:WarningResultViewModel}">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Result.Parsed}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FailureResultViewModel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="{DynamicResource Brush.ErrorWash}"
              BorderBrush="{DynamicResource Brush.ErrorBorder}"
              BorderThickness="{StaticResource Border.Bottom}"
              CornerRadius="{StaticResource Radius.PanelTop}"
              Padding="{StaticResource Space.MessageBar}">
        <StackPanel Orientation="Horizontal">
          <Border Width="{StaticResource Size.StatusGlyph}"
                  Height="{StaticResource Size.StatusGlyph}"
                  Margin="{StaticResource Space.Right8}"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Brush.Error}"
                  CornerRadius="{StaticResource Radius.Control}">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Surface}"
                       FontSize="11"
                       FontWeight="{StaticResource Weight.Bold}"
                       Text="!" />
          </Border>
          <TextBlock VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="{StaticResource Weight.SemiBold}"
                     Foreground="{DynamicResource Brush.ErrorText}"
                     TextWrapping="Wrap"
                     Text="{Binding Headline}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Space.16}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap" Text="{Binding Cause}" />
          <TextBlock Margin="{StaticResource Space.Top12}"
                     Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap"
                     Text="{Binding NextStep}" />

          <ToggleButton x:Name="DetailsToggle"
                        Margin="{StaticResource Space.Top12}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Toggle.Subtle}"
                        Content="Technical details"
                        AutomationProperties.Name="Show technical details" />
          <Border Margin="{StaticResource Space.Top8}"
                  Padding="{StaticResource Space.12}"
                  Background="{DynamicResource Brush.SurfaceInset}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="{StaticResource Border.All}"
                  CornerRadius="{StaticResource Radius.Bar}"
                  Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource Text.Metadata}"
                       TextWrapping="Wrap"
                       Text="{Binding TechnicalDetails}" />
          </Border>

          <StackPanel Margin="{StaticResource Space.Top12}" Orientation="Horizontal">
            <Button Margin="{StaticResource Space.Right8}"
                    Style="{StaticResource Button.Compact}"
                    Content="Copy details"
                    Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Copy technical details" />
            <Button Style="{StaticResource Button.Compact}"
                    Content="Choose another file"
                    Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Choose another file" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DataTemplate>

  <!-- ============================ Overlay dialogs ============================ -->

  <DataTemplate DataType="{x:Type vm:OverwriteDialogViewModel}">
    <Border Style="{StaticResource Surface.Dialog}">
      <StackPanel>
        <TextBlock FontSize="16"
                   FontWeight="{StaticResource Weight.SemiBold}"
                   TextWrapping="Wrap"
                   Text="{Binding Title}" />
        <TextBlock Margin="{StaticResource Space.Top12}"
                   Style="{StaticResource Text.BodySecondary}"
                   TextWrapping="Wrap"
                   Text="{Binding Message}" />
        <StackPanel Margin="{StaticResource Space.Top20}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
          <Button Margin="{StaticResource Space.Right8}"
                  Style="{StaticResource Button.Secondary}"
                  Content="Save a copy"
                  Command="{Binding SaveCopyCommand}"
                  AutomationProperties.Name="Save a copy" />
          <Button Margin="{StaticResource Space.Right8}"
                  Style="{StaticResource Button.Destructive}"
                  Content="Replace"
                  Command="{Binding ReplaceCommand}"
                  AutomationProperties.Name="Replace the existing workbook" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.Name="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Fills the window (less the host margin) until the corner grip is dragged; the dragged size
       lives on the view model so Edit pricing reopens at the same size. -->
  <DataTemplate DataType="{x:Type vm:LinePricingViewModel}">
    <Border Style="{StaticResource Surface.Card}"
            CornerRadius="{StaticResource Radius.Dialog}"
            MinWidth="760"
            MinHeight="400"
            Width="{Binding DialogWidth, Mode=TwoWay}"
            Height="{Binding DialogHeight, Mode=TwoWay}"
            mvvm:DialogResizeBehavior.IsResizable="True"
            AutomationProperties.Name="Line pricing review">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dialog header -->
        <Border Grid.Row="0"
                Padding="{StaticResource Space.16}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{StaticResource Border.Bottom}">
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.SectionHeading}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="LINE PRICING" />
            <TextBlock DockPanel.Dock="Left"
                       Margin="{StaticResource Space.Horizontal12}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Subtitle}" />
            <Border DockPanel.Dock="Right"
                    Padding="{StaticResource Space.Horizontal8}"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.InfoWash}"
                    BorderBrush="{DynamicResource Brush.InfoBorder}"
                    BorderThickness="{StaticResource Border.All}"
                    CornerRadius="{StaticResource Radius.Bar}">
              <TextBlock Style="{StaticResource Text.Caption}"
                         FontWeight="{StaticResource Weight.SemiBold}"
                         Foreground="{DynamicResource Brush.InfoText}"
                         Text="{Binding CurrencyBadgeText}" />
            </Border>
          </DockPanel>
        </Border>

        <!-- Header inputs + Apply buttons -->
        <Border Grid.Row="1"
                Padding="{StaticResource Space.16}"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{StaticResource Border.Bottom}">
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
            <!-- Wide enough for a 4 d.p. rate such as 12.3456 beside the "USD to AUD" suffix. -->
            <StackPanel Width="240"
                        Margin="{StaticResource Space.Right12}"
                        Visibility="{Binding UsesFxRate, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ContentControl Content="{Binding FxRate}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="{StaticResource Space.Right12}"
                        Visibility="{Binding ImPercentEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel Width="160">
                <ContentControl Content="{Binding HeaderImPercent}" />
              </StackPanel>
              <Button Margin="6,30,0,0"
                      VerticalAlignment="Top"
                      Style="{StaticResource Button.Secondary}"
                      Content="Apply to all"
                      Command="{Binding ApplyImPercentCommand}"
                      AutomationProperties.Name="Apply IM% to all lines" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
              <StackPanel Width="160">
                <ContentControl Content="{Binding HeaderUplift}" />
              </StackPanel>
              <Button Margin="6,30,0,0"
                      VerticalAlignment="Top"
                      Style="{StaticResource Button.Secondary}"
                      Content="Apply to all"
                      Command="{Binding ApplyUpliftCommand}"
                      AutomationProperties.Name="Apply Uplift to all lines" />
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- 12-column DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                  Background="{DynamicResource Brush.Surface}"
                  RowBackground="{DynamicResource Brush.Surface}"
                  AlternatingRowBackground="{DynamicResource Brush.Surface}"
                  BorderThickness="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ColumnHeaderStyle="{StaticResource Grid.ColumnHeader}"
                  AutomationProperties.Name="Quote lines pricing grid">
          <DataGrid.Resources>
            <!-- Also reaches the filler header to the right of the last column. -->
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Grid.ColumnHeader}" />
          </DataGrid.Resources>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="ToolTip" Value="{Binding RowErrorMessage}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Line#" Binding="{Binding LineNumber}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="VPN" Binding="{Binding Vpn}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTemplateColumn Header="Description" Width="*" MinWidth="180" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Grid.CellText}"
                             Text="{Binding Description}"
                             ToolTip="{Binding Description}"
                             AutomationProperties.Name="{Binding Description}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="MSRP" Binding="{Binding MsrpDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTemplateColumn Header="IM%*" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="{StaticResource Space.2}">
                    <TextBox Style="{StaticResource Grid.CellInput.ImPercent}"
                             Text="{Binding ImPercent, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsImEditable, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="{Binding ImErrorMessage}"
                             AutomationProperties.Name="Line IM%" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Cost" Binding="{Binding SourceCostDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCostDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="Ext Cost" Binding="{Binding ExtCostDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTemplateColumn Header="Uplift%*" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="{StaticResource Space.2}">
                    <TextBox Style="{StaticResource Grid.CellInput.Uplift}"
                             Text="{Binding Uplift, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsUpliftEditable, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="{Binding UpliftErrorMessage}"
                             AutomationProperties.Name="Line Uplift%" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPriceDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="Ext Price" Binding="{Binding ExtPriceDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Totals footer + Cancel / Next -->
        <Border Grid.Row="3"
                Padding="{StaticResource Space.16}"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{StaticResource Border.Top}">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <StackPanel Margin="{StaticResource Space.Right12}">
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="TOTAL COST" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Text="{Binding TotalCostDisplay}" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Space.Right12}">
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="TOTAL PRICE" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Text="{Binding TotalPriceDisplay}" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Space.Right12}">
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="TOTAL MARGIN $" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Foreground="{DynamicResource Brush.SuccessText}"
                           Text="{Binding TotalMarginAmountDisplay}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Text.SectionHeading}" Text="TOTAL MARGIN %" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Foreground="{DynamicResource Brush.SuccessText}"
                           Text="{Binding TotalMarginPercentDisplay}" />
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Margin="{StaticResource Space.Right8}"
                      Style="{StaticResource Button.Secondary}"
                      Content="Cancel"
                      Command="{Binding CancelCommand}"
                      AutomationProperties.Name="Cancel pricing review" />
              <Button Style="{StaticResource Button.Primary}"
                      Content="Next"
                      Command="{Binding NextCommand}"
                      AutomationProperties.Name="Confirm pricing and continue" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Corner resize grip: drag to resize, double-click to fill the window again. At 14 DIP
             with a 2 DIP inset it stays inside the footer's 16 DIP padding, clear of Next. -->
        <Thumb Grid.Row="3"
               Width="14"
               Height="14"
               Margin="0,0,2,2"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Focusable="False"
               ToolTip="Drag to resize · double-click to fill the window"
               mvvm:DialogResizeBehavior.IsGrip="True"
               AutomationProperties.Name="Resize line pricing">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <Path HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Stroke="{DynamicResource Brush.TextMuted}"
                      StrokeThickness="1.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 11,3 L 3,11 M 11,7 L 7,11" />
              </Grid>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
