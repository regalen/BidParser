<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cfg="clr-namespace:BidParser.Desktop.Configuration"
                    xmlns:mvvm="clr-namespace:BidParser.Desktop.Mvvm"
                    xmlns:vm="clr-namespace:BidParser.Desktop.ViewModels">

  <!-- Guidance blocks. The model is already validated; these templates only lay it out. -->
  <DataTemplate DataType="{x:Type cfg:GuidanceParagraph}">
    <TextBlock Margin="{StaticResource Space.Bottom4}"
               Style="{StaticResource Text.BodySecondary}"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
               TextWrapping="Wrap"
               mvvm:GuidanceInlines.Runs="{Binding Runs}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type cfg:GuidanceListItem}">
    <Grid Margin="{StaticResource Space.Bottom2}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="{StaticResource Space.Right8}"
                 VerticalAlignment="Top"
                 Style="{StaticResource Text.BodySecondary}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Text="•" />
      <TextBlock Grid.Column="1"
                 Style="{StaticResource Text.BodySecondary}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextWrapping="Wrap"
                 mvvm:GuidanceInlines.Runs="{Binding Runs}" />
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type cfg:GuidanceBulletList}">
    <ItemsControl Margin="{StaticResource Space.Bottom4}" ItemsSource="{Binding Items}" />
  </DataTemplate>
  <!-- Surfaces use the Windows 11 theme brushes: translucent cards over the Mica window, solid
       dialogs over the smoke scrim, and InfoBar-style message bars. -->
  <Style x:Key="Surface.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
  </Style>

  <Style x:Key="Surface.MessageBar" TargetType="Border" BasedOn="{StaticResource Surface.Card}">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Bar}" />
    <Setter Property="Padding" Value="{StaticResource Space.MessageBar}" />
  </Style>

  <Style x:Key="Bar.Info" TargetType="Border" BasedOn="{StaticResource Surface.MessageBar}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
  </Style>
  <Style x:Key="Bar.Success" TargetType="Border" BasedOn="{StaticResource Surface.MessageBar}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
  </Style>
  <Style x:Key="Bar.Warning" TargetType="Border" BasedOn="{StaticResource Surface.MessageBar}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
  </Style>

  <!-- A round InfoBar-style status icon: coloured disc, inverse glyph. -->
  <Style x:Key="Glyph.Message" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource Size.MessageGlyph}" />
    <Setter Property="Height" Value="{StaticResource Size.MessageGlyph}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.MessageGlyph}" />
    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
  </Style>
  <Style x:Key="Glyph.Status" TargetType="Border" BasedOn="{StaticResource Glyph.Message}">
    <Setter Property="Width" Value="{StaticResource Size.StatusGlyph}" />
    <Setter Property="Height" Value="{StaticResource Size.StatusGlyph}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.StatusGlyph}" />
  </Style>
  <Style x:Key="Glyph.Text" TargetType="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.Bold}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorInverseBrush}" />
  </Style>

  <!-- The drop zone hosts its own state surfaces, so the button itself contributes only the
       focus ring and the hit area. -->
  <Style x:Key="Surface.DropZone" TargetType="Button">
    <!-- This style is not based on the theme's button, so it states the theme's text colour;
         otherwise the drop zone's text falls back to black in dark mode. -->
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                    BorderThickness="{StaticResource Border.Focus}"
                    CornerRadius="{StaticResource Radius.Panel}"
                    Visibility="Collapsed" />
            <ContentPresenter Margin="{StaticResource Space.2}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Data grid body text: vertically centred, trimmed, padded. Size and colour come from the
       theme. -->
  <Style x:Key="Grid.CellText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="{StaticResource Space.Horizontal8}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Editable grid cell (IM%, Uplift). The border reports the field's state: red while the value
       is missing or invalid, green once it is valid, neutral when an optional field is blank. The
       template keeps that colour while focused (focus thickens the border instead of recolouring
       it), so the state is visible while the user types. Derived styles supply the state triggers.
       Fill, corners and text follow the Windows 11 text box. -->
  <Style x:Key="Grid.CellInput" TargetType="TextBox">
    <Setter Property="Width" Value="82" />
    <Setter Property="Height" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Control}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="{StaticResource Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Grid.CellInput.ImPercent" TargetType="TextBox" BasedOn="{StaticResource Grid.CellInput}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsImValueValid}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasImError}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Grid.CellInput.Uplift" TargetType="TextBox" BasedOn="{StaticResource Grid.CellInput}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsUpliftValueValid}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding HasUpliftError}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The theme's column header, with its text centred over the column. -->
  <Style x:Key="Grid.ColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="Surface.Dialog" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource Size.DialogWidth}" />
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}" />
    <Setter Property="Padding" Value="{StaticResource Space.24}" />
  </Style>

  <!-- The single dialog host: scrim plus a centred dialog, drawn over the whole window rather
       than in a second Window, so Esc handling and focus stay in one place. -->
  <Style x:Key="Overlay.DialogHost" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Host for a dialog that fills the window (less a margin) by default and can be resized with
       its grip; the dialog's own Width/Height, once dragged, centre it within this area. -->
  <Style x:Key="Overlay.ResizableDialogHost" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <ContentPresenter Margin="{StaticResource Space.24}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Drop zone states ============================ -->

  <DataTemplate DataType="{x:Type vm:EmptyDropZoneViewModel}">
    <Grid>
      <Rectangle RadiusX="{StaticResource Radius.PanelValue}"
                 RadiusY="{StaticResource Radius.PanelValue}"
                 Fill="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                 Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                 StrokeThickness="{StaticResource Size.BorderThickness}"
                 StrokeDashArray="4 2" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center"
                   FontWeight="{StaticResource Weight.SemiBold}"
                   Text="Drop quote file here" />
        <TextBlock Margin="{StaticResource Space.Top4}"
                   HorizontalAlignment="Center"
                   Style="{StaticResource Text.Caption}"
                   Text="{Binding AcceptedCaption}" />
        <TextBlock Margin="{StaticResource Space.Top8}"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   FontWeight="{StaticResource Weight.SemiBold}"
                   FontSize="13"
                   Text="Browse…" />
        <TextBlock Margin="{StaticResource Space.Top4}"
                   HorizontalAlignment="Center"
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="One file at a time · Ctrl+O opens the file picker" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DragOverDropZoneViewModel}">
    <Grid>
      <Rectangle RadiusX="{StaticResource Radius.PanelValue}"
                 RadiusY="{StaticResource Radius.PanelValue}"
                 Fill="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                 Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                 StrokeThickness="2"
                 StrokeDashArray="4 2" />
      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                 FontWeight="{StaticResource Weight.SemiBold}"
                 Text="Release to load" />
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:InvalidDropZoneViewModel}">
    <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
            BorderThickness="{StaticResource Border.All}"
            CornerRadius="{StaticResource Radius.Panel}"
            Padding="{StaticResource Space.16}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource Glyph.Message}"
                Margin="{StaticResource Space.Right12}"
                VerticalAlignment="Top"
                Background="{DynamicResource SystemFillColorCriticalBrush}">
          <TextBlock Style="{StaticResource Glyph.Text}"
                     Text="!" />
        </Border>
        <StackPanel>
          <TextBlock FontWeight="{StaticResource Weight.SemiBold}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding Headline}" />
          <TextBlock Margin="{StaticResource Space.Top4}"
                     Style="{StaticResource Text.BodySecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding Detail}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FileDropZoneViewModel}">
    <Border Style="{StaticResource Surface.Card}"
            Padding="{StaticResource Space.Horizontal12}">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="{StaticResource Size.FileBadgeWidth}"
                Height="{StaticResource Size.FileBadgeHeight}"
                Margin="{StaticResource Space.Right12}"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource Border.All}"
                CornerRadius="{StaticResource Radius.Bar}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="{StaticResource Space.Bottom4}"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     FontSize="9"
                     FontWeight="{StaticResource Weight.Bold}"
                     Text="{Binding File.Badge}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock FontWeight="{StaticResource Weight.SemiBold}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding File.DisplayName}"
                     ToolTip="{Binding File.DisplayName}" />
          <TextBlock Margin="{StaticResource Space.Top2}"
                     Style="{StaticResource Text.Caption}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding File.Metadata}" />
          <TextBlock x:Name="Status"
                     Margin="{StaticResource Space.Top4}"
                     Style="{StaticResource Text.Caption}"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Status}" />
        </StackPanel>

        <Button Grid.Column="2"
                Margin="{StaticResource Space.Right8}"
                Style="{StaticResource Button.Compact}"
                Content="Replace"
                Visibility="{Binding CanReplace, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Replace quote file" />
        <Button Grid.Column="3"
                Style="{StaticResource Button.Subtle}"
                Content="✕"
                Visibility="{Binding CanReplace, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                AutomationProperties.Name="Clear quote file" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:FileStatusSeverity.Working}">
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:FileStatusSeverity.Done}">
        <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ============================ Result region ============================ -->

  <DataTemplate DataType="{x:Type vm:NoResultViewModel}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="{StaticResource Size.Control}"
              Height="{StaticResource Size.Control}"
              HorizontalAlignment="Center"
              Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
              BorderThickness="{StaticResource Border.All}"
              CornerRadius="{StaticResource Radius.Control}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="↔" />
      </Border>
      <TextBlock Margin="{StaticResource Space.Top12}"
                 HorizontalAlignment="Center"
                 FontWeight="{StaticResource Weight.SemiBold}"
                 Text="No quote parsed yet" />
      <TextBlock Margin="{StaticResource Space.Top4}"
                 HorizontalAlignment="Center"
                 Style="{StaticResource Text.Caption}"
                 Text="Warnings, totals and the saved workbook path appear here." />
    </StackPanel>
  </DataTemplate>

  <DataTemplate x:Key="Result.Parsed">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBand"
              Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="{StaticResource Border.Bottom}"
              CornerRadius="{StaticResource Radius.PanelTop}"
              Padding="{StaticResource Space.MessageBar}">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="HeaderGlyphChrome"
                  Style="{StaticResource Glyph.Status}"
                  Margin="{StaticResource Space.Right8}"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SystemFillColorSuccessBrush}">
            <TextBlock x:Name="HeaderGlyph"
                       Style="{StaticResource Glyph.Text}"
                       Text="✓" />
          </Border>
          <TextBlock x:Name="HeaderText"
                     VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="{StaticResource Weight.SemiBold}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding Headline}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Space.16}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.BodySecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding Detail}" />

          <ItemsControl Margin="{StaticResource Space.Top12}"
                        ItemsSource="{Binding Facts}"
                        Visibility="{Binding Facts, Converter={StaticResource EmptyToVisibility}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="{StaticResource Space.Bottom12}">
                  <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                  <TextBlock Margin="{StaticResource Space.Top2}"
                             FontWeight="{StaticResource Weight.SemiBold}"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Value}"
                             ToolTip="{Binding Value}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Notes}"
                        Visibility="{Binding Notes, Converter={StaticResource EmptyToVisibility}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Bar.Warning}" Margin="{StaticResource Space.Bottom8}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="{StaticResource Space.Right8}"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               FontWeight="{StaticResource Weight.Bold}"
                               Text="⚠" />
                    <TextBlock Style="{StaticResource Text.BodySecondary}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Bar.Info}"
                  Margin="{StaticResource Space.Bottom8}"
                  Visibility="{Binding Guidance, Converter={StaticResource EmptyToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Glyph.Message}"
                      Margin="{StaticResource Space.Right8}"
                      VerticalAlignment="Top"
                      Background="{DynamicResource SystemFillColorAttentionBrush}">
                <TextBlock Style="{StaticResource Glyph.Text}"
                           Text="i" />
              </Border>
              <ItemsControl ItemsSource="{Binding Guidance.Blocks}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Bar.Success}"
                  Visibility="{Binding SavedMessage, Converter={StaticResource EmptyToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         Style="{StaticResource Text.BodySecondary}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding SavedMessage}"
                         ToolTip="{Binding SavedPath}" />
              <Button Grid.Column="1"
                      Margin="{StaticResource Space.Horizontal8}"
                      Style="{StaticResource Button.Compact}"
                      Content="Open folder"
                      Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      AutomationProperties.Name="Open the folder containing the saved workbook" />
            </Grid>
          </Border>

          <StackPanel Margin="{StaticResource Space.Top12}" Orientation="Horizontal">
            <Button Margin="{StaticResource Space.Right8}"
                    Style="{StaticResource Button.Compact}"
                    Content="Edit pricing"
                    Visibility="{Binding CanEditPricing, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding DataContext.EditPricingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Edit per-line pricing" />
            <Button Style="{StaticResource Button.Compact}"
                    Content="Parse another file"
                    Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Parse another file" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Severity}" Value="{x:Static vm:ResultSeverity.Warning}">
        <Setter TargetName="HeaderBand" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter TargetName="HeaderBand" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter TargetName="HeaderGlyphChrome" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        <Setter TargetName="HeaderGlyph" Property="Text" Value="!" />
        <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SuccessResultViewModel}">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Result.Parsed}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:WarningResultViewModel}">
    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Result.Parsed}" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:FailureResultViewModel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="{StaticResource Border.Bottom}"
              CornerRadius="{StaticResource Radius.PanelTop}"
              Padding="{StaticResource Space.MessageBar}">
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource Glyph.Status}"
                  Margin="{StaticResource Space.Right8}"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SystemFillColorCriticalBrush}">
            <TextBlock Style="{StaticResource Glyph.Text}"
                       Text="!" />
          </Border>
          <TextBlock VerticalAlignment="Center"
                     FontSize="16"
                     FontWeight="{StaticResource Weight.SemiBold}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding Headline}" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Space.16}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap" Text="{Binding Cause}" />
          <TextBlock Margin="{StaticResource Space.Top12}"
                     Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap"
                     Text="{Binding NextStep}" />

          <Expander Margin="{StaticResource Space.Top12}"
                    HorizontalAlignment="Stretch"
                    Header="Technical details"
                    AutomationProperties.Name="Technical details">
            <TextBlock Style="{StaticResource Text.Metadata}"
                       TextWrapping="Wrap"
                       Text="{Binding TechnicalDetails}" />
          </Expander>

          <StackPanel Margin="{StaticResource Space.Top12}" Orientation="Horizontal">
            <Button Margin="{StaticResource Space.Right8}"
                    Style="{StaticResource Button.Compact}"
                    Content="Copy details"
                    Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Copy technical details" />
            <Button Style="{StaticResource Button.Compact}"
                    Content="Choose another file"
                    Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    AutomationProperties.Name="Choose another file" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DataTemplate>

  <!-- ============================ Overlay dialogs ============================ -->

  <DataTemplate DataType="{x:Type vm:OverwriteDialogViewModel}">
    <Border Style="{StaticResource Surface.Dialog}">
      <StackPanel>
        <TextBlock FontSize="16"
                   FontWeight="{StaticResource Weight.SemiBold}"
                   TextWrapping="Wrap"
                   Text="{Binding Title}" />
        <TextBlock Margin="{StaticResource Space.Top12}"
                   Style="{StaticResource Text.BodySecondary}"
                   TextWrapping="Wrap"
                   Text="{Binding Message}" />
        <StackPanel Margin="{StaticResource Space.Top20}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
          <Button Margin="{StaticResource Space.Right8}"
                  Style="{StaticResource Button.Secondary}"
                  Content="Save a copy"
                  Command="{Binding SaveCopyCommand}"
                  AutomationProperties.Name="Save a copy" />
          <Button Margin="{StaticResource Space.Right8}"
                  Style="{StaticResource Button.Primary}"
                  Content="Replace"
                  Command="{Binding ReplaceCommand}"
                  AutomationProperties.Name="Replace the existing workbook" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Cancel"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.Name="Cancel" />
        </StackPanel>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Fills the window (less the host margin) until the corner grip is dragged; the dragged size
       lives on the view model so Edit pricing reopens at the same size. -->
  <DataTemplate DataType="{x:Type vm:LinePricingViewModel}">
    <Border Style="{StaticResource Surface.Card}"
            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            CornerRadius="{StaticResource Radius.Dialog}"
            MinWidth="760"
            MinHeight="400"
            Width="{Binding DialogWidth, Mode=TwoWay}"
            Height="{Binding DialogHeight, Mode=TwoWay}"
            mvvm:DialogResizeBehavior.IsResizable="True"
            AutomationProperties.Name="Line pricing review">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Dialog header -->
        <Border Grid.Row="0"
                Padding="{StaticResource Space.16}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource Border.Bottom}">
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.SectionHeading}"
                       FontSize="20"
                       Text="Line pricing" />
            <TextBlock DockPanel.Dock="Left"
                       Margin="{StaticResource Space.Horizontal12}"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Subtitle}" />
            <Border DockPanel.Dock="Right"
                    Padding="{StaticResource Space.Horizontal8}"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="{StaticResource Border.All}"
                    CornerRadius="{StaticResource Radius.Bar}">
              <TextBlock Style="{StaticResource Text.Caption}"
                         FontWeight="{StaticResource Weight.SemiBold}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Text="{Binding CurrencyBadgeText}" />
            </Border>
          </DockPanel>
        </Border>

        <!-- Header inputs + Apply buttons -->
        <Border Grid.Row="1"
                Padding="{StaticResource Space.16}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource Border.Bottom}">
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
            <!-- Every numeric box shares Size.NumericInput, so the three header fields line up. -->
            <StackPanel Margin="0,0,32,0"
                        Visibility="{Binding UsesFxRate, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ContentControl Content="{Binding FxRate}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,32,0"
                        Visibility="{Binding ImPercentEditable, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <ContentControl Content="{Binding HeaderImPercent}" />
              </StackPanel>
              <Button Margin="6,35,0,0"
                      VerticalAlignment="Top"
                      Style="{StaticResource Button.Secondary}"
                      Content="Apply to all"
                      Command="{Binding ApplyImPercentCommand}"
                      AutomationProperties.Name="Apply IM% to all lines" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
              <StackPanel>
                <ContentControl Content="{Binding HeaderUplift}" />
              </StackPanel>
              <Button Margin="6,35,0,0"
                      VerticalAlignment="Top"
                      Style="{StaticResource Button.Secondary}"
                      Content="Apply to all"
                      Command="{Binding ApplyUpliftCommand}"
                      AutomationProperties.Name="Apply Uplift to all lines" />
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- Line filter: hides rows only; totals, validation and Apply to all cover every line. -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Margin="{StaticResource Space.Right8}"
                     VerticalAlignment="Center"
                     Style="{StaticResource Text.FormLabel}"
                     Text="Filter" />
          <ComboBox Grid.Column="1"
                    Width="190"
                    Margin="{StaticResource Space.Right8}"
                    VerticalAlignment="Center"
                    Style="{StaticResource Input.ComboBox}"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilterOption}"
                    DisplayMemberPath="Name"
                    AutomationProperties.Name="Filter column" />
          <TextBox Grid.Column="2"
                   Width="220"
                   Margin="{StaticResource Space.Right12}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Input.TextBox}"
                   Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Filter text" />
          <CheckBox Grid.Column="3"
                    Margin="{StaticResource Space.Right12}"
                    VerticalAlignment="Center"
                    Style="{StaticResource Input.CheckBox}"
                    Content="Only lines needing attention"
                    IsChecked="{Binding ShowOnlyNeedingAttention}"
                    AutomationProperties.Name="Show only lines with a missing or invalid IM% or Uplift" />
          <Button Grid.Column="4"
                  VerticalAlignment="Center"
                  Style="{StaticResource Button.Subtle}"
                  Content="Clear"
                  Command="{Binding ClearFilterCommand}"
                  Visibility="{Binding IsFiltered, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutomationProperties.Name="Clear the line filter" />
          <TextBlock Grid.Column="5"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Style="{StaticResource Text.Caption}"
                     Text="{Binding FilterSummary}" />
        </Grid>

        <!-- 12-column DataGrid. Every column sizes to its content so nothing is clipped;
             Description takes what is left and gives way first when the window is narrow. -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding VisibleRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                  Background="Transparent"
                  BorderThickness="0"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ColumnHeaderStyle="{StaticResource Grid.ColumnHeader}"
                  AutomationProperties.Name="Quote lines pricing grid">
          <DataGrid.Resources>
            <!-- Also reaches the filler header to the right of the last column. -->
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Grid.ColumnHeader}" />
          </DataGrid.Resources>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
              <Setter Property="ToolTip" Value="{Binding RowErrorMessage}" />
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Line#" Binding="{Binding LineNumber}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="VPN" Binding="{Binding Vpn}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTemplateColumn Header="Description" Width="*" MinWidth="120" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Style="{StaticResource Grid.CellText}"
                             Text="{Binding Description}"
                             ToolTip="{Binding Description}"
                             AutomationProperties.Name="{Binding Description}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="MSRP" Binding="{Binding MsrpDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTemplateColumn Header="IM%*" Width="Auto" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="{StaticResource Space.2}">
                    <TextBox Style="{StaticResource Grid.CellInput.ImPercent}"
                             Text="{Binding ImPercent, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsImEditable, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="{Binding ImErrorMessage}"
                             AutomationProperties.Name="Line IM%" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Cost" Binding="{Binding SourceCostDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCostDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="Ext Cost" Binding="{Binding ExtCostDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTemplateColumn Header="Uplift%*" Width="Auto" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid Margin="{StaticResource Space.2}">
                    <TextBox Style="{StaticResource Grid.CellInput.Uplift}"
                             Text="{Binding Uplift, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsUpliftEditable, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="{Binding UpliftErrorMessage}"
                             AutomationProperties.Name="Line Uplift%" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPriceDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
            <DataGridTextColumn Header="Ext Price" Binding="{Binding ExtPriceDisplay}" ElementStyle="{StaticResource Grid.CellText}" IsReadOnly="True" Width="Auto" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Totals footer + Cancel / Submit -->
        <Border Grid.Row="4"
                Padding="{StaticResource Space.16}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="{StaticResource Border.Top}"
                CornerRadius="0,0,8,8">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <StackPanel Margin="{StaticResource Space.Right12}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="Total cost" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Text="{Binding TotalCostDisplay}" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Space.Right12}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="Total price" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Text="{Binding TotalPriceDisplay}" />
              </StackPanel>
              <StackPanel Margin="{StaticResource Space.Right12}">
                <TextBlock Style="{StaticResource Text.Caption}" Text="Total margin $" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                           Text="{Binding TotalMarginAmountDisplay}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Text="Total margin %" />
                <TextBlock Margin="{StaticResource Space.Top2}"
                           FontWeight="{StaticResource Weight.SemiBold}"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                           Text="{Binding TotalMarginPercentDisplay}" />
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Margin="{StaticResource Space.Right8}"
                      Style="{StaticResource Button.Secondary}"
                      Content="Cancel"
                      Command="{Binding CancelCommand}"
                      AutomationProperties.Name="Cancel pricing review" />
              <Button Style="{StaticResource Button.Primary}"
                      Content="Submit"
                      Command="{Binding NextCommand}"
                      AutomationProperties.Name="Confirm pricing and continue" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Corner resize grip: drag to resize, double-click to fill the window again. At 14 DIP
             with a 2 DIP inset it stays inside the footer's 16 DIP padding, clear of Next. -->
        <Thumb Grid.Row="4"
               Width="14"
               Height="14"
               Margin="0,0,2,2"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Focusable="False"
               ToolTip="Drag to resize · double-click to fill the window"
               mvvm:DialogResizeBehavior.IsGrip="True"
               AutomationProperties.Name="Resize line pricing">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <Path HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                      StrokeThickness="1.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 11,3 L 3,11 M 11,7 L 7,11" />
              </Grid>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
