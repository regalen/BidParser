<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Text uses the Windows 11 theme's own font (Segoe UI Variable, falling back to Segoe UI) and
       inherits its foreground from the hosting control, so there is deliberately no implicit
       TextBlock style: one would override the text colour inside every Fluent control template.
       These keyed styles follow the Windows 11 type ramp (Caption 12, Body 14, Body Strong 14,
       Subtitle 20) and use the theme's text brushes. -->
  <FontFamily x:Key="Font.Monospace">Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Weight.Regular">Regular</FontWeight>
  <FontWeight x:Key="Weight.SemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="Weight.Bold">Bold</FontWeight>

  <Style x:Key="Text.WindowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
  </Style>
  <Style x:Key="Text.SectionHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="Text.FormLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="Text.Body" TargetType="TextBlock" />
  <Style x:Key="Text.BodySecondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.Metadata" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="Text.FooterVersion" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style x:Key="Text.Validation" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
</ResourceDictionary>
