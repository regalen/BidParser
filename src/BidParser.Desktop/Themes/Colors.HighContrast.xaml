<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="Color.WindowBackground">Black</Color>
  <Color x:Key="Color.Surface">Black</Color>
  <Color x:Key="Color.SurfaceInset">Black</Color>
  <Color x:Key="Color.SurfaceHover">Black</Color>
  <Color x:Key="Color.SurfaceEmpty">Black</Color>
  <Color x:Key="Color.Border">White</Color>
  <Color x:Key="Color.BorderStrong">White</Color>
  <Color x:Key="Color.BorderAccent">White</Color>
  <Color x:Key="Color.TextPrimary">White</Color>
  <Color x:Key="Color.TextBody">White</Color>
  <Color x:Key="Color.TextSecondary">White</Color>
  <Color x:Key="Color.TextMuted">White</Color>
  <Color x:Key="Color.TextDisabled">Gray</Color>
  <Color x:Key="Color.Accent">Yellow</Color>
  <Color x:Key="Color.AccentHover">Yellow</Color>
  <Color x:Key="Color.AccentPressed">Yellow</Color>
  <Color x:Key="Color.AccentForeground">Black</Color>
  <Color x:Key="Color.Success">Lime</Color>
  <Color x:Key="Color.Warning">Yellow</Color>
  <Color x:Key="Color.Error">Red</Color>
  <Color x:Key="Color.InfoWash">Black</Color>
  <Color x:Key="Color.SuccessWash">Black</Color>
  <Color x:Key="Color.WarningWash">Black</Color>
  <Color x:Key="Color.ErrorWash">Black</Color>
  <Color x:Key="Color.InfoBorder">White</Color>
  <Color x:Key="Color.SuccessBorder">White</Color>
  <Color x:Key="Color.WarningBorder">White</Color>
  <Color x:Key="Color.ErrorBorder">White</Color>
  <Color x:Key="Color.InfoText">Yellow</Color>
  <Color x:Key="Color.SuccessText">Lime</Color>
  <Color x:Key="Color.WarningText">Yellow</Color>
  <Color x:Key="Color.ErrorText">Red</Color>
  <Color x:Key="Color.Scrim">#99000000</Color>

  <SolidColorBrush x:Key="Brush.WindowBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.SurfaceInset" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.SurfaceEmpty" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.BorderAccent" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.TextBody" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.AccentForeground" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
  <SolidColorBrush x:Key="Brush.InfoWash" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.SuccessWash" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.WarningWash" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.ErrorWash" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
  <SolidColorBrush x:Key="Brush.Focus" Color="{DynamicResource {x:Static SystemColors.HotTrackColorKey}}" />
  <SolidColorBrush x:Key="Brush.InfoBorder" Color="{StaticResource Color.InfoBorder}" />
  <SolidColorBrush x:Key="Brush.SuccessBorder" Color="{StaticResource Color.SuccessBorder}" />
  <SolidColorBrush x:Key="Brush.WarningBorder" Color="{StaticResource Color.WarningBorder}" />
  <SolidColorBrush x:Key="Brush.ErrorBorder" Color="{StaticResource Color.ErrorBorder}" />
  <SolidColorBrush x:Key="Brush.InfoText" Color="{StaticResource Color.InfoText}" />
  <SolidColorBrush x:Key="Brush.SuccessText" Color="{StaticResource Color.SuccessText}" />
  <SolidColorBrush x:Key="Brush.WarningText" Color="{StaticResource Color.WarningText}" />
  <SolidColorBrush x:Key="Brush.ErrorText" Color="{StaticResource Color.ErrorText}" />
  <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
</ResourceDictionary>
