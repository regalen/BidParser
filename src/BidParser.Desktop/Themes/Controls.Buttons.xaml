<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Buttons are the Windows 11 theme's own buttons. These styles only fix the sizes the layout
       was designed around; colours, corners, hover/pressed states and focus come from the theme. -->
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.SecondaryMinWidth}" />
  </Style>

  <!-- The accent button: the one primary action in each area. -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.PrimaryMinWidth}" />
  </Style>

  <Style x:Key="Button.Compact" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Height" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="Padding" Value="{StaticResource Space.Horizontal10}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Borderless until hovered, like Windows 11 title-bar and close buttons. -->
  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Compact}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
</ResourceDictionary>
