<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource Size.Control}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.SecondaryMinWidth}" />
    <Setter Property="Padding" Value="{StaticResource Space.Button}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="{StaticResource Border.All}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Brush.Focus}"
                    BorderThickness="{StaticResource Border.Focus}"
                    CornerRadius="{StaticResource Radius.Panel}"
                    Visibility="Collapsed" />
            <Border x:Name="Chrome"
                    Margin="{StaticResource Space.2}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Control}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                RecognizesAccessKey="True" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="MinWidth" Value="{StaticResource Size.PrimaryMinWidth}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentForeground}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Button.Compact" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="Height" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="MinWidth" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="Padding" Value="{StaticResource Space.ButtonCompact}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Compact}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style x:Key="Button.Destructive" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
  </Style>

  <!-- Disclosure toggle for the collapsed technical-details block. -->
  <Style x:Key="Toggle.Subtle" TargetType="ToggleButton">
    <Setter Property="Height" Value="{StaticResource Size.CompactControl}" />
    <Setter Property="Padding" Value="{StaticResource Space.ButtonCompact}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Brush.Focus}"
                    BorderThickness="{StaticResource Border.Focus}"
                    CornerRadius="{StaticResource Radius.Panel}"
                    Visibility="Collapsed" />
            <Border x:Name="Chrome"
                    Margin="{StaticResource Space.2}"
                    Padding="{TemplateBinding Padding}"
                    Background="Transparent"
                    CornerRadius="{StaticResource Radius.Control}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Chevron"
                           Margin="{StaticResource Space.Right4}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="10"
                           Text="▶" />
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="Text" Value="▼" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
