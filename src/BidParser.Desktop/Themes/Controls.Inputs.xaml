<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mvvm="clr-namespace:BidParser.Desktop.Mvvm">
  <!-- Inputs are the Windows 11 theme's own controls. These styles keep only the sizes and text
       alignment the layout depends on. -->
  <Style x:Key="Input.TextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="Input.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="Input.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />

  <!-- Numbers are right-aligned so decimal places line up, in boxes of one fixed width. -->
  <Style x:Key="Input.Numeric" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
    <Setter Property="Width" Value="{StaticResource Size.NumericInput}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- One pricing row: label, helper, input with its unit beside it, and its validation message. -->
  <DataTemplate DataType="{x:Type mvvm:NumericFieldViewModel}">
    <StackPanel Margin="{StaticResource Space.Top12}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding Label}" />
        <TextBlock Margin="{StaticResource Space.Horizontal8}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.Caption}"
                   Text="{Binding Helper}"
                 Visibility="{Binding Helper, Converter={StaticResource EmptyToVisibility}}" />
      </StackPanel>
      <Grid Margin="{StaticResource Space.Top4}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource Input.Numeric}"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 mvvm:NumericInputBehavior.NormalizeOnLostFocus="True"
                 AutomationProperties.Name="{Binding Label}" />
        <TextBlock Grid.Column="1"
                   Margin="{StaticResource Space.Horizontal8}"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.BodySecondary}"
                   TextWrapping="NoWrap"
                   Text="{Binding Unit}"
                   Visibility="{Binding Unit, Converter={StaticResource EmptyToVisibility}}" />
      </Grid>
      <TextBlock Margin="{StaticResource Space.Top4}"
                 Style="{StaticResource Text.Validation}"
                 TextWrapping="Wrap"
                 Text="{Binding ErrorMessage}"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToVisibility}}" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
