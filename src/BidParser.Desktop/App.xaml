<Application x:Class="BidParser.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The built-in Windows 11 (Fluent) theme comes first so the dictionaries after it can
             derive from its control styles and use its theme brushes. App.OnStartup sets
             ThemeMode = System, so WPF itself follows Windows light, dark and high-contrast modes. -->
        <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
        <ResourceDictionary Source="Themes/Metrics.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Converters.xaml" />
        <ResourceDictionary Source="Themes/Controls.Buttons.xaml" />
        <ResourceDictionary Source="Themes/Controls.Inputs.xaml" />
        <ResourceDictionary Source="Themes/Controls.Surfaces.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
