<Application x:Class="BidParser.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Dictionary 0 is the theme: the theme service swaps it and nothing else changes. -->
        <ResourceDictionary Source="Themes/Colors.Light.xaml" />
        <ResourceDictionary Source="Themes/Metrics.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Converters.xaml" />
        <ResourceDictionary Source="Themes/Controls.Buttons.xaml" />
        <ResourceDictionary Source="Themes/Controls.Inputs.xaml" />
        <ResourceDictionary Source="Themes/Controls.Surfaces.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
