<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit.net v3 test projects are stand-alone executables. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken) arrived with the v3 analyzers; adopting it
         across the existing suites is a separate change. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BidParser.Application\BidParser.Application.csproj" />
    <ProjectReference Include="..\..\src\BidParser.Domain\BidParser.Domain.csproj" />
    <ProjectReference Include="..\..\src\BidParser.Output\BidParser.Output.csproj" />
    <ProjectReference Include="..\..\src\BidParser.Parsing\BidParser.Parsing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
</Project>
